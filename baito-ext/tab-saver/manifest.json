{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "SafeTabs",
  "description": "__MSG_appDesc__",
  "version": "1.0.0",
  "default_locale": "en",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "__MSG_appName__", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "storage", "unlimitedStorage", "alarms", "favicon"],
  "commands": {
    "save-window": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "__MSG_cmdSave__" }
  }
}
